{
  "rules": {
    ".read": false,
    ".write": false,
    "tasks": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$taskId": {
        ".validate": "newData.hasChildren(['title', 'column'])",
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "description": { ".validate": "newData.isString() && newData.val().length <= 10000" },
        "category": { ".validate": "newData.val() === 'userStory' || newData.val() === 'technicalTask' || newData.val() === 'bug'" },
        "priority": { ".validate": "newData.val() === 'urgent' || newData.val() === 'medium' || newData.val() === 'low'" },
        "column": { ".validate": "newData.val() === 'triage' || newData.val() === 'todo' || newData.val() === 'inProgress' || newData.val() === 'awaitFeedback' || newData.val() === 'done'" },
        "lastNotifiedColumn": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "order": { ".validate": "newData.isNumber()" },
        "movedAt": { ".validate": "newData.isNumber()" },
        "dueDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
        "createdAt": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
        "aiGenerated": { ".validate": "newData.isBoolean()" },
        "assignedTo": {
          "$index": { ".validate": "newData.isString() && newData.val().length <= 40" }
        },
        "creator": {
          ".validate": "newData.hasChildren(['name', 'type'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
          "type": { ".validate": "newData.val() === 'internal' || newData.val() === 'external'" },
          "$other": { ".validate": false }
        },
        "subtasks": {
          "$subtaskId": {
            ".validate": "newData.hasChildren(['title', 'done'])",
            "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "done": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "contacts": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$contactId": {
        ".validate": "newData.hasChildren(['name', 'email'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "$other": { ".validate": false }
      }
    },
    "requestStats": {
      ".read": true
    }
  }
}
