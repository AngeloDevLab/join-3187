    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const EMAIL = /^[^\\s@<>\"]+@[^\\s@<>\"]+\\.[^\\s@<>\"]+$/;\n\n\n/**\n * Trims a single-line value, replaces characters that could break mail headers\n * (line breaks, <, >, \") and caps its length.\n * @param {unknown} value - raw value from the request body\n * @param {number} max - maximum length\n * @returns {string}\n */\nfunction cleanLine(value, max) {\n    return String(value ?? '').replace(/[\\r\\n<>\"]/g, ' ').trim().slice(0, max);\n}\n\n\n/**\n * Validates the stakeholder form again on the server, since the browser check can be bypassed.\n * @param {{ name?: string, email?: string, subject?: string, message?: string }} body - JSON body of the webhook\n * @returns {{ valid: boolean, name: string, email: string, subject: string, message: string }}\n */\nfunction validateRequest(body) {\n    const request = {\n        name: cleanLine(body.name, 100),\n        email: cleanLine(body.email, 254).toLowerCase(),\n        subject: cleanLine(body.subject, 150),\n        message: String(body.message ?? '').trim().slice(0, 5000),\n    };\n    const valid = !!request.name && EMAIL.test(request.email) && !!request.subject && !!request.message;\n    return { valid, ...request };\n}\n\n\nreturn { json: validateRequest($json.body ?? {}) };\n"
      },
