    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "/**\n * Reduces a resolved IMAP email to the fields the pipeline needs.\n * Requests sent through the Join form arrive from the Join inbox itself,\n * with the stakeholder in Reply-To — so Reply-To wins over From.\n * @param {Object} mail - item from the Email Trigger (format \"Resolved\")\n * @returns {{ uid: number, messageId: string, name: string, email: string, subject: string, body: string }}\n */\nfunction extractEmail(mail) {\n    const sender = mail.replyTo?.value?.[0] ?? mail.from.value[0];\n    return {\n        uid: mail.attributes.uid,\n        messageId: mail.messageId,\n        name: sender.name || sender.address,\n        email: sender.address.toLowerCase(),\n        subject: (mail.subject ?? '').trim(),\n        body: (mail.text ?? '').trim().slice(0, 5000),\n    };\n}\n\n\nreturn { json: extractEmail($json) };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        352
      ],
      "id": "0c4c1697-382a-42a7-8f2c-cf5598ee19ba",
      "name": "Extract email"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "/**\n * Builds a Join task from the AI analysis and the email sender.\n * It lands at the end of the Triage column, with the sender as external creator.\n * @param {{ title: string, description: string, category: string, priority: string, dueDate: string }} ai\n * @param {{ name: string, email: string }} sender\n * @returns {Object} the task as stored under tasks/ in Firebase\n */\nfunction buildTask(ai, sender) {\n    const task = {\n        title: ai.title, description: ai.description,\n        category: ai.category, priority: ai.priority,\n        column: 'triage', order: Date.now(),\n        createdAt: $now.toFormat('yyyy-MM-dd'), aiGenerated: true,\n        creator: { name: sender.name, email: sender.email, type: 'external' },\n    };\n    if (/^\\d{4}-\\d{2}-\\d{2}$/.test(ai.dueDate)) task.dueDate = ai.dueDate;\n    return task;\n}\n\n\nreturn { json: buildTask($json.output, $('Extract email').item.json) };\n"
      },
