        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"title\": { \"type\": \"string\", \"description\": \"Short, precise ticket title, max. 60 characters, in the language of the email\" },\n    \"description\": { \"type\": \"string\", \"description\": \"Clear summary of the request in 1-3 sentences, in the language of the email\" },\n    \"category\": { \"type\": \"string\", \"enum\": [\"userStory\", \"technicalTask\", \"bug\"], \"description\": \"bug: something is broken or behaves wrongly. userStory: a new feature or change visible to users. technicalTask: internal technical work without new user-facing features (refactoring, setup, performance, security).\" },\n    \"priority\": { \"type\": \"string\", \"enum\": [\"urgent\", \"medium\", \"low\"], \"description\": \"urgent: words like dringend, urgent, asap, sofort, kritisch, blockiert, or a deadline within 7 days. low: words like irgendwann, nice to have, kein Stress, low priority. Otherwise medium.\" },\n    \"dueDate\": { \"type\": \"string\", \"description\": \"Deadline as YYYY-MM-DD if the email mentions one (resolve relative dates like 'Ende November' using Today), otherwise an empty string\" }\n  },\n  \"required\": [\"title\", \"description\", \"category\", \"priority\", \"dueDate\"]\n}\n",
