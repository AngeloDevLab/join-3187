    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const COLUMN_LABELS = { triage: 'Triage', todo: 'To Do', inProgress: 'In Progress', awaitFeedback: 'Awaiting Feedback', done: 'Done' };\n\n\n/**\n * Decides whether the creator gets a mail: only external creators with an email,\n * and only if the task now sits in a different column than the one they were\n * last told about. Tickets start in Triage, so that is the default.\n * @param {Object} task - the task as stored in Firebase ({} if it was deleted)\n * @returns {{ notify: boolean, column: string, columnLabel: string, title: string, name: string, email: string }}\n */\nfunction decide(task) {\n    const creator = task.creator ?? {};\n    const lastNotified = task.lastNotifiedColumn ?? 'triage';\n    return {\n        notify: creator.type === 'external' && !!creator.email && !!COLUMN_LABELS[task.column] && task.column !== lastNotified,\n        column: task.column,\n        columnLabel: COLUMN_LABELS[task.column] ?? '',\n        title: task.title ?? '',\n        name: creator.name ?? '',\n        email: creator.email ?? '',\n    };\n}\n\n\nreturn { json: decide($json) };\n"
      },
